graph TD
    %% Base Styling
    classDef avatar fill:#1a1a1a,stroke:#555,stroke-width:2px,color:#fff;
    classDef layer1 fill:#1E90FF,stroke:#000,stroke-width:1px,color:#fff;
    classDef layer2 fill:#FFA500,stroke:#000,stroke-width:1px,color:#000;
    classDef layer3 fill:#D2452B,stroke:#000,stroke-width:1px,color:#fff;
    classDef output fill:#2ecc71,stroke:#000,stroke-width:2px,color:#fff;

    %% Input Data
    subgraph Input [The Raw Material]
        A["The 28 Avatar Psychographics<br/>(Trauma, Obstacles, Doubts, Goals, Fears, Identity, Beliefs... etc.)"]:::avatar
    end

    %% Layer 1
    subgraph Layer1 [Layer 1: Conditions - The Inner Layer]
        L1_Eq["The Action Equation<br/>[Pain of Inaction] - [Pain of Action] + [Confidence in Action] = Chance of Action"]:::layer1
        
        L1_M1["Module 1: Specific Conditions<br/>Law of the Lock, Condition Scalability & Potency"]:::layer1
        L1_M2["Module 2: Text-Subtext<br/>Principle of Pain Awareness (Blame)"]:::layer1
        L1_M3["Module 3: Liking-Relatability<br/>Confidence in You/Client"]:::layer1
        L1_M4["Module 4: Pain-Confidence<br/>Value Relativity (Proportional to Pain)"]:::layer1
        L1_M5["Module 5: Problem Chains<br/>Core Desire -> Big Problem -> Fractals -> Unique Mechanism"]:::layer1
        L1_M6["Module 6: Urgency-Scarcity<br/>Sequential Value Creation"]:::layer1
        L1_M7["Module 7: Concise-Curiosity<br/>Decrease Pain of Action (New, Easy, Safe)"]:::layer1
        L1_M8["Module 8: Synthesis<br/>1. Increase Pressure<br/>2. Decrease Friction<br/>3. Build Confidence"]:::layer1
        
        L1_Eq --> L1_M1
        L1_M1 --> L1_M2 & L1_M3 & L1_M4 & L1_M5 & L1_M6 & L1_M7
        L1_M2 & L1_M3 & L1_M4 & L1_M5 & L1_M6 & L1_M7 --> L1_M8
    end

    %% Layer 2
    subgraph Layer2 [Layer 2: Judgment - The Cognitive Engine]
        L2_Schema["The 16-Level Ontological Stack<br/>Mapping Shallow 'What' to Deep 'Why'"]:::layer2
        
        L2_L1_4["Levels 1-4: Biological/Evolutionary<br/>Homeostasis, Threat Detection, Affective Systems"]:::layer2
        L2_L5_8["Levels 5-8: Psychological/Cognitive<br/>Identity, Cognitive Depletion, Secure Base"]:::layer2
        L2_L9_13["Levels 9-13: Social/Cultural<br/>Relative Position, Dominance, Social Exclusion"]:::layer2
        L2_L14_16["Levels 14-16: Ideological/Philosophical<br/>Crisis of Meaning, Legacy, Flourishing"]:::layer2
        
        L2_Hypo{"Forming Positioning Hypotheses<br/>Finding the White Space"}:::layer2
        L2_H1["Hypothesis A: Primal Angle<br/>Dominance & Status Preservation"]:::layer2
        L2_H2["Hypothesis B: Tribal Angle<br/>Ingroup Belonging & Signaling"]:::layer2
        L2_H3["Hypothesis C: Transcendent Angle<br/>Good Life & Ultimate Potential"]:::layer2
        
        L2_Action["Eliciting Action via Triggers<br/>Dopaminergic Seeking, Uncertainty Reduction, Reciprocity, Identity Alignment"]:::layer2

        L2_Schema --> L2_L1_4 & L2_L5_8 & L2_L9_13 & L2_L14_16
        L2_L1_4 & L2_L5_8 & L2_L9_13 & L2_L14_16 --> L2_Hypo
        L2_Hypo --> L2_H1 & L2_H2 & L2_H3
        L2_H1 & L2_H2 & L2_H3 --> L2_Action
    end

    %% Layer 3
    subgraph Layer3 [Layer 3: Taste - The Nuanced Execution]
        L3_Meta["Metaphysics of Marketing<br/>Quantum Energy Manipulation & Belief Shifting"]:::layer3
        L3_Opt["Total System Optimization<br/>Signal vs Noise & Incongruence"]:::layer3
        
        L3_Nodes["Nuanced Decision Nodes"]:::layer3
        L3_Sig["Signal Ownership<br/>One Primary Carrier (Narration, Visuals, etc.)"]:::layer3
        L3_Traj["Dynamic Trajectory Mapping<br/>Knowledge, Emotion, Memory, Action, Load"]:::layer3
        L3_LBC["LBC Framework<br/>Lead (Pierce Noise)<br/>Body (Shatter Beliefs)<br/>Close (Logical Salvation)"]:::layer3
        
        L3_Conflict{"Conflict Resolution<br/>Pain vs Confidence Balance"}:::layer3
        L3_Tension["The Tension of Pain<br/>Over/Understimulation & Cognitive Friction"]:::layer3
        L3_Release["The Release of Confidence<br/>Dropping Mechanism/Proof"]:::layer3
        
        L3_Meta --> L3_Opt
        L3_Opt --> L3_Nodes
        L3_Nodes --> L3_Sig & L3_Traj & L3_LBC
        L3_Sig & L3_Traj & L3_LBC --> L3_Conflict
        L3_Conflict --> L3_Tension
        L3_Tension --> L3_Release
    end

    %% Connections
    A --> L1_Eq
    L1_M8 --> L2_Schema
    L2_Action --> L3_Meta
    
    Final(("Final Execution:<br/>Compelled, High-Confidence Conversion")):::output
    L3_Release --> Final
